# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE SHEETS BACKUP SYSTEM CONFIGURATION
# OPTION A: Google Apps Script Web App URL (Easiest & recommended for mobile users - no Google Cloud project needed!)
GOOGLE_SHEETS_WEBAPP_URL=""

# OPTION B: Google Service Account method (Requires Google Cloud Console setup)
# Google Service Account client email (e.g., sheets-backup@project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Google Service Account private key (must include standard "-----BEGIN PRIVATE KEY-----" prefix)
GOOGLE_PRIVATE_KEY=""
# Target Google Sheet Spreadsheet ID (extracted from its URL)
GOOGLE_SPREADSHEET_ID=""
# Specific tab name to append data to (e.g. "Attendees")
GOOGLE_SHEET_NAME="Attendees"

